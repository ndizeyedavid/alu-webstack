
#!/usr/bin/env bash
# Display information about a domain's subdomains

domain=$1

display_subdomain() {
    subdomain=$1

    record=$(dig +noall +answer "${subdomain}.${domain}" | awk 'NR == 1 {print $4, $5}')

    read -r record_type destination <<< "$record"

    echo "The subdomain ${subdomain} is a ${record_type} record and points to ${destination}"
}

if [ "$#" -eq 2 ]; then
    display_subdomain "$2"
else
    for subdomain in www lb-01 web-01 web-02; do
        display_subdomain "$subdomain"
    done
fi
